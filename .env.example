# API
API_KEYS=local-dev-key,second-key
MAX_UPLOAD_BYTES=536870912
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Infrastructure
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/transcriptions
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=audio
S3_REGION=us-east-1

# Transcription engine: whisper | mock
ENGINE=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

# Media tooling
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT_SECONDS=1800

# Long audio chunking
CHUNK_THRESHOLD_SECONDS=600
CHUNK_MIN_SECONDS=30
CHUNK_TARGET_SECONDS=45
CHUNK_MAX_SECONDS=60
CHUNK_OVERLAP_SECONDS=1
SILENCE_NOISE_DB=-30
SILENCE_MIN_DURATION=0.35

# Retention and retries
RAW_AUDIO_RETENTION_DAYS=30
RETENTION_CLEANUP_HOURS=6
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=10
WEBHOOK_TIMEOUT_SECONDS=10
